  arrangement   String?  // JSON: [{ studentId, row, col }] — student seat assignments
  showDoor      Boolean  @default(true)
  showWindows   Boolean  @default(true)
  doorPosition  String   @default("left") // left, right, back
  windowPosition String  @default("right") // left, right, both
  isTemplate    Boolean  @default(false)
  isDefault     Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school       School     @relation(fields: [schoolId], references: [id])
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  teacher      User       @relation(fields: [teacherId], references: [id])

  @@index([schoolId])
  @@index([classGroupId])
  @@index([teacherId])
  @@map("seating_charts")
}

model DataImportJob {
  id          String   @id @default(cuid())
  schoolId    String
  userId      String
  type        String   // STUDENT, TEACHER, GRADE, ATTENDANCE, COMPETENCY
  fileName    String
  fileSize    Int
  status      String   @default("pending") // pending, processing, completed, failed
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  errorRows   Int      @default(0)
  errors      String?  // JSON string of error details
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@map("data_import_jobs")
}

model DataExportJob {
  id          String   @id @default(cuid())
  schoolId    String
  userId      String
  type        String   // STUDENT, GRADE, ATTENDANCE, COMPETENCY, REPORT
  format      String   // CSV, JSON
  filters     String?  // JSON string of filter parameters
  fileName    String?
  fileSize    Int      @default(0)
  status      String   @default("pending") // pending, processing, completed, failed
  fileData    String?  // Base64 encoded file data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@map("data_export_jobs")
}

model WellnessCheckin {
  id              String   @id @default(cuid())
  schoolId        String
  studentId       String
  date            DateTime
  mood            Int      // 1-5
  sleepHours      Float?
  sleepQuality    Int?     // 1-5
  stressLevel     Int?     // 1-10
  activityType    String?
  activityMinutes Int?
  mealsCount      Int?
  waterGlasses    Int?
  gratitudeEntry  String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school          School   @relation(fields: [schoolId], references: [id])
  student         Student  @relation(fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([date])
  @@map("wellness_checkins")
}

model WellnessScore {
  id              String   @id @default(cuid())
  schoolId        String
  studentId       String
  date            DateTime
  overallScore    Float    // 0-100
  physicalScore   Float?   // 0-100
  mentalScore     Float?   // 0-100
  socialScore     Float?   // 0-100
  academicScore   Float?   // 0-100
  createdAt       DateTime @default(now())

  school          School   @relation(fields: [schoolId], references: [id])
  student         Student  @relation(fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([date])
  @@map("wellness_scores")
}

// ─── Student Career & Guidance ───────────────────────────────────────

model CareerProfile {
  id              String   @id @default(cuid())
  schoolId        String
  studentId       String   @unique
  interests       String?  // JSON: ["technology", "health", "business"]
  strengths       String?  // JSON: ["mathematics", "communication"]
  careerCluster   String?  // Technology, Health, Business, Arts, Science, Social
  desiredCareer   String?
  educationPath   String?  // Hauptschule, Realschule, Gymnasium, Berufsschule
  workExperiences String?  // JSON: [{ company, role, startDate, endDate }]
  volunteerExps   String?  // JSON: [{ organization, role, startDate, endDate }]
  certifications  String?  // JSON: [{ name, date, issuer }]
  documents       String?  // JSON: [{ name, url, type }]
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school          School   @relation(fields: [schoolId], references: [id])
  student         Student  @relation(fields: [studentId], references: [id])
  goals           CareerGoal[]
  appointments    CareerAppointment[]

  @@index([schoolId])
  @@index([studentId])
  @@index([careerCluster])
  @@map("career_profiles")
}

model CareerGoal {
  id              String   @id @default(cuid())
  profileId       String
  title           String
  description     String?
  category        String   // short_term, long_term, academic, professional
  targetDate      DateTime?
  progress        Int      @default(0) // 0-100
  status          String   @default("active") // active, completed, abandoned
  milestones      String?  // JSON: [{ title, completed, date }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile         CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([category])
  @@index([status])
  @@map("career_goals")
}

model CareerAppointment {
  id              String   @id @default(cuid())
  schoolId        String
  profileId       String
  counselorId     String
  date            DateTime
  duration        Int      @default(30) // minutes
  type            String   @default("guidance") // guidance, career, academic, college
  status          String   @default("scheduled") // scheduled, completed, cancelled
  notes           String?
  actionItems     String?  // JSON: [{ item, completed }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school          School        @relation(fields: [schoolId], references: [id])
  profile         CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  counselor       User          @relation(fields: [counselorId], references: [id])

  @@index([schoolId])
  @@index([profileId])
  @@index([counselorId])
  @@index([date])
  @@index([status])
  @@map("career_appointments")
}

model SubstituteTeacher {
  id                String   @id @default(cuid())
  schoolId          String
  userId            String?  @unique // optional link to User account
  firstName         String
  lastName          String
  email             String?
  phone             String?
  qualifications    String?  // JSON: ["Mathematics", "Physics", "German"]
  subjects          String?  // JSON: subject IDs they can teach
  gradeLevels       String?  // JSON: ["1-4", "5-6", "7-10"]
  availability      String?  // JSON: { "monday": ["08:00-12:00"], "tuesday": [...] }
  maxDaysPerWeek    Int      @default(5)
  rating            Float    @default(0)  // 0-5 average rating
  totalAssignments  Int      @default(0)
  notes             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  school            School   @relation(fields: [schoolId], references: [id])
  user              User?    @relation(fields: [userId], references: [id])
  assignments       SubstitutionAssignment[]

  @@index([schoolId])
  @@index([userId])
  @@map("substitute_teachers")
}

model TeacherAbsence {
  id              String   @id @default(cuid())
  schoolId        String
  teacherId       String
  type            String   // SICK, PERSONAL, TRAINING, OTHER
  startDate       DateTime
  endDate         DateTime
  reason          String?
  status          String   @default("reported") // reported, covered, cancelled
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school          School   @relation(fields: [schoolId], references: [id])
  teacher         User     @relation(fields: [teacherId], references: [id])
  assignments     SubstitutionAssignment[]

  @@index([schoolId])
  @@index([teacherId])
  @@index([startDate])
  @@map("teacher_absences")
}

model SubstitutionAssignment {
  id              String   @id @default(cuid())
  schoolId        String
  absenceId       String
  substituteId    String
  classGroupId    String?
  subjectId       String?
  date            DateTime
  period          Int?     // lesson period number
  room            String?
  status          String   @default("pending") // pending, confirmed, completed, cancelled
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school          School             @relation(fields: [schoolId], references: [id])
  absence         TeacherAbsence     @relation(fields: [absenceId], references: [id])
  substitute      SubstituteTeacher  @relation(fields: [substituteId], references: [id])
  classGroup      ClassGroup?        @relation(fields: [classGroupId], references: [id])
  subject         Subject?           @relation(fields: [subjectId], references: [id])

  @@index([schoolId])
  @@index([absenceId])
  @@index([substituteId])
  @@index([date])
  @@map("substitution_assignments")
}

// ─── Grade Analytics & Reporting ──────────────────────────────────

model GradeReport {
  id              String   @id @default(cuid())
  schoolId        String
  generatedBy     String
  title           String
  type            String   @default("custom") // quarterly, semester, annual, custom
  dateRange       String   // JSON: { from, to }
  classIds        String?  // JSON: array of class IDs
  subjectIds      String?  // JSON: array of subject IDs
  metrics         String?  // JSON: array of selected metrics
  status          String   @default("pending") // pending, completed, failed
  fileData        String?  // Base64 encoded or JSON report data
  createdAt       DateTime @default(now())

  school          School   @relation(fields: [schoolId], references: [id])
  generator       User     @relation("GradeReportGenerator", fields: [generatedBy], references: [id])

  @@index([schoolId])
  @@index([generatedBy])
}

// ─── Module L: Legal & Data Protection Compliance ──────────────────

model DataRetentionPolicy {
  id                      String   @id @default(cuid())
  schoolId                String
  dataCategory            String   // LEARNING_PROGRESS, ASSESSMENT_RESULT, FINAL_REPORT, DISCIPLINARY_RECORD, EXAM_INCIDENT, MESSAGE, AI_TUTOR_LOG, NOTEBOOK_PAGE, SIGNAGE_LOG, TEACHER_AUDIT_LOG
  retentionPeriodMonths   Int?     // nullable to force DPO to fill in legally-mandated categories
  legalBasisNote          String?  // DPO notes on state-specific retention rule
  isDefault               Boolean  @default(false) // false = legally mandated; true = optional product data
  reviewedByUserId        String?  // DPO approval
  reviewedAt              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  school                  School   @relation(fields: [schoolId], references: [id])
  reviewedByUser          User?    @relation("DataRetentionPolicyReviewer", fields: [reviewedByUserId], references: [id])

  @@index([schoolId])
  @@index([dataCategory])
}

model DpiaRecord {
  id                      String   @id @default(cuid())
  schoolId                String
  moduleScope             String   // AI_TUTOR, EXAM_MODE, WELLNESS_CHECKS, SIGNAGE_EMERGENCY, MESSAGING, LEARNING_ANALYTICS
  dataProcessingSummary   String   // what's processed, for how long, who sees it
  completedAt             DateTime
  approvedByUserId        String?  // DPO approval
  documentUrl             String?  // uploaded DPIA PDF
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  school                  School   @relation(fields: [schoolId], references: [id])
  approvedByUser          User?    @relation("DpiaRecordApprover", fields: [approvedByUserId], references: [id])

  @@index([schoolId])
  @@index([moduleScope])
  @@unique([schoolId, moduleScope])
}

model ComplianceConsultation {
  id                      String   @id @default(cuid())
  schoolId                String
  consultationType        String   // ELTERNBEIRAT, SCHULKONFERENZ, PERSONALRAT
  moduleScope             String?  // specific module if Personalrat for monitoring-capable features
  acknowledgedByUserId    String
  acknowledgedAt          DateTime
  notes                   String?  // what was consulted/approved
  createdAt               DateTime @default(now())

  school                  School   @relation(fields: [schoolId], references: [id])
  acknowledgedByUser      User     @relation("ComplianceConsultationAcknowledger", fields: [acknowledgedByUserId], references: [id])

  @@index([schoolId])
  @@index([consultationType])
}

model SchoolComplianceStatus {
  id                      String   @id @default(cuid())
  schoolId                String   @unique
  bundesland              String?  // BERLIN, BREMEN, HAMBURG, etc. (16 states)
  onboardingCompleted     Boolean  @default(false)
  dpoDpoContactEmail      String?
  schultragerContactEmail String?
  moduleGates             String?  // JSON: { "AI_TUTOR": { isApprovedForUse: bool, diaCompleted: bool }, ... }
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  school                  School   @relation(fields: [schoolId], references: [id])
}

model DeletionFlag {
  id                      String   @id @default(cuid())
  schoolId                String
  entityType              String   // Student, Message, Notebook, etc.
  entityId                String
  dataCategory            String   // retention category reference
  flaggedAt               DateTime @default(now())
  approvedByUserId        String?
  approvedAt              DateTime?
  deletedAt               DateTime?
  reason                  String   // "retention period expired", "erasure request", etc.

  school                  School   @relation(fields: [schoolId], references: [id])
  approvedByUser          User?    @relation("DeletionFlagApprover", fields: [approvedByUserId], references: [id])

  @@index([schoolId])
  @@index([entityType])
  @@index([flaggedAt])
}

// ─── Module B: Emergency Signage System ─────────────────────────────

model EmergencySignage {
  id                String   @id @default(cuid())
  schoolId          String
  displayName       String   // Room name or location (e.g., "Main Hallway", "Cafeteria TV 1")
  signageType       String   @default("digital_display") // digital_display, led_board, tv_monitor
  resolution        String   @default("1920x1080") // resolution info
  location          String   // Physical location in school
  isActive          Boolean  @default(true)
  currentMessageId  String?  // Current active message
  brightness        Int      @default(100) // 1-100
  volume            Int      @default(50) // 1-100 for audio
  ipAddress         String?  // For network monitoring
  lastHeartbeat     DateTime? // Last connection check
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school            School   @relation(fields: [schoolId], references: [id])
  messages          SignageMessage[]
  schedules         SignageSchedule[]

  @@index([schoolId])
  @@index([isActive])
  @@map("emergency_signages")
}

model SignageMessage {
  id                String   @id @default(cuid())
  schoolId          String
  signageId         String
  title             String
  content           String   // HTML or plain text
  messageType       String   // emergency, notification, schedule, announcement, alert
  priority          String   @default("normal") // low, normal, high, critical
  backgroundColor   String?  // Hex color
  textColor         String?  // Hex color
  displayDuration   Int      @default(10) // seconds to display
  soundAlert        Boolean  @default(false) // Play sound on emergency
  soundFile         String?  // URL to audio file
  createdBy         String   // userId who created
  createdAt         DateTime @default(now())
  startTime         DateTime?
  endTime           DateTime?
  displayOrder      Int      @default(0)

  school            School   @relation(fields: [schoolId], references: [id])
  signage           EmergencySignage @relation(fields: [signageId], references: [id], onDelete: Cascade)
  creator           User     @relation(fields: [createdBy], references: [id])
  audits            SignageAuditLog[]

  @@index([schoolId])
  @@index([signageId])
  @@index([messageType])
  @@index([priority])
  @@map("signage_messages")
}

model SignageSchedule {
  id                String   @id @default(cuid())
  schoolId          String
  signageId         String
  messageId         String?  // Optional: specific message to display
  dayOfWeek         Int      // 0-6 (Sunday-Saturday)
  startTime         String   // HH:mm format
  endTime           String   // HH:mm format
  isRecurring       Boolean  @default(true)
  createdBy         String   // userId
  createdAt         DateTime @default(now())

  school            School   @relation(fields: [schoolId], references: [id])
  signage           EmergencySignage @relation(fields: [signageId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([signageId])
  @@map("signage_schedules")
}

model SignageAuditLog {
  id                String   @id @default(cuid())
  schoolId          String
  messageId         String
  action            String   // created, updated, displayed, error, offline
  details           String?  // JSON: { status, device, error, etc }
  createdAt         DateTime @default(now())

  school            School   @relation(fields: [schoolId], references: [id])
  message           SignageMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([messageId])
  @@index([action])
  @@map("signage_audit_logs")
}
