// ─── Subject Content Management (Schlaukopf Clone) ──────────────────

model SubjectCategory {
  id          String   @id @default(cuid())
  schoolId    String
  name        String   // e.g. "Klasse 5", "Klasse 6", "Oberstufe"
  slug        String   // e.g. "klasse5", "klasse6", "oberstufe"
  description String?
  icon        String?  // Lucide icon name
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id])
  contents    SubjectContent[]

  @@index([schoolId])
  @@index([slug])
  @@map("subject_categories")
}

model SubjectContent {
  id           String   @id @default(cuid())
  schoolId     String
  categoryId   String
  subjectId    String?  // Link to existing Subject
  parentId     String?  // For nested topics
  title        String
  slug         String
  description  String?
  icon         String?  // Lucide icon name
  contentType  String   @default("topic") // topic, exercise, lesson, quiz, vocabulary
  content      String?  // JSON content (questions, explanations, etc.)
  difficulty   String   @default("medium") // easy, medium, hard
  questionCount Int     @default(0)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  isPublic     Boolean  @default(true) // visible to all schools
  sourceUrl    String?  // original schlaukopf.de URL
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school      School          @relation(fields: [schoolId], references: [id])
  category    SubjectCategory @relation(fields: [categoryId], references: [id])
  parent      SubjectContent? @relation("ContentHierarchy", fields: [parentId], references: [id])
  children    SubjectContent[] @relation("ContentHierarchy")
  changeRequests ContentChangeRequest[]
  subject     Subject?        @relation(fields: [subjectId], references: [id])

  @@index([schoolId])
  @@index([categoryId])
  @@index([parentId])
  @@index([slug])
  @@index([contentType])
  @@map("subject_contents")
}

model ContentChangeRequest {
  id          String   @id @default(cuid())
  schoolId    String
  contentId   String
  requestedBy String
  requestType String   // edit, add, delete
  title       String
  description String
  proposedChanges String? // JSON with proposed changes
  status      String   @default("pending") // pending, approved, rejected
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school     School          @relation(fields: [schoolId], references: [id])
  content    SubjectContent  @relation(fields: [contentId], references: [id])
  requester  User            @relation("ContentRequester", fields: [requestedBy], references: [id])
  reviewer   User?           @relation("ContentReviewer", fields: [reviewedBy], references: [id])

  @@index([schoolId])
  @@index([contentId])
  @@index([status])
  @@index([requestedBy])
  @@map("content_change_requests")
}

// ─── AI Settings (Pollination, OpenAI, Anthropic) ────────────────────

model AISettings {
  id                    String   @id @default(cuid())
  schoolId              String   @unique
  // Pollination AI
  pollinationEnabled    Boolean  @default(true)
  pollinationApiKey     String?
  pollinationModel      String   @default("flux")
  // OpenAI
  openaiEnabled         Boolean  @default(false)
