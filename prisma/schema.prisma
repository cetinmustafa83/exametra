  review      TeacherGradingReview @relation(fields: [reviewId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([reviewId])
  @@index([userId])
  @@map("grading_review_comments")
}

// ─── Grading Annotations (Tablet Stylus) ────────────────────────────

model GradingAnnotation {
  id              String   @id @default(cuid())
  schoolId        String
  assessmentId    String
  studentId       String
  resultId        String?  // AssessmentResult ID
  teacherId       String
  type            String   @default("drawing") // drawing, text, highlight, stamp
