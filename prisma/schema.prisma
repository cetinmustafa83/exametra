  schoolId    String
  bookId      String
  studentId   String
  userId      String   // The user who made the reservation (could be parent)
  queuePosition Int    @default(1)
  status      String   @default("waiting") // waiting, notified, fulfilled, cancelled
  notifiedAt  DateTime?
  fulfilledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id])
  book        LibraryBook  @relation(fields: [bookId], references: [id])
  student     Student      @relation(fields: [studentId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([bookId])
  @@index([studentId])
  @@index([status])
  @@map("book_reservations")
}

// ─── Seating Charts ──────────────────────────────────────────────────

model SeatingChart {
  id            String   @id @default(cuid())
