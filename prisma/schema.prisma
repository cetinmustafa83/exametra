  reviewer      User?    @relation("CaseReviewer", fields: [reviewedBy], references: [id])

  @@index([schoolId])
  @@index([committeeId])
  @@index([studentId])
  @@index([status])
  @@map("disciplinary_cases")
}

// ─── AI Test Generation ──────────────────────────────────────────────

model AITestGeneration {
