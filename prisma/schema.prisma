// ─── Illness Reporting with Parent Approval ──────────────────────────

model IllnessReport {
  id            String   @id @default(cuid())
  schoolId      String
  studentId     String
  reportedBy    String   // userId of the person reporting
  reporterType  String   // student, parent
  reason        String   // illness, doctor_visit, other
  description   String?
  startDate     DateTime
  endDate       DateTime?
  documentUrl   String?  // Medical certificate URL
