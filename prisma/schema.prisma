// ─── Communication Rooms (Student-Teacher) ───────────────────────────

model CommunicationRoom {
  id            String   @id @default(cuid())
  schoolId      String
  studentId     String
  teacherId     String
  roomType      String   @default("chat") // chat, voice, video
  status        String   @default("requested") // requested, active, closed
