}

// ─── Chat Messages (AI Chatbot & Student-Teacher) ────────────────────

model ChatMessage {
  id          String   @id @default(cuid())
  schoolId    String
  userId      String
  roomId      String?  // For room-based chat (null = AI chatbot)
  content     String
  senderType  String   @default("user") // user, ai, teacher, system
