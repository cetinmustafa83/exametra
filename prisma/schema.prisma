  @@index([studentId])
  @@index([startTime])
  @@index([status])
  @@map("study_sessions")
}

// ─── School Library ──────────────────────────────────────────────────

model LibraryBook {
  id              String   @id @default(cuid())
  schoolId        String
  title           String
  author          String
  isbn            String?
  publisher       String?
  publishYear     Int?
  category        String   // Fiction, Non-Fiction, Science, History, etc.
  readingLevel    String?  // elementary, middle, high, advanced
  language        String   @default("de")
  description     String?
  coverGradient   String?  // JSON: {from, to} gradient colors for placeholder
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  location        String?  // Shelf/room location
  tags            String?  // JSON array of tag strings
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school        School            @relation(fields: [schoolId], references: [id])
  checkouts     BookCheckout[]
  reservations  BookReservation[]

  @@index([schoolId])
  @@index([category])
  @@index([readingLevel])
  @@index([author])
  @@map("library_books")
}

model BookCheckout {
  id              String   @id @default(cuid())
  schoolId        String
  bookId          String
  studentId       String
  checkedOutBy    String   // userId of the person who processed the checkout
  checkoutDate    DateTime @default(now())
  dueDate         DateTime
  returnDate      DateTime?
  condition       String   @default("good") // excellent, good, fair, poor
  returnCondition String?  // Condition upon return
  renewalCount    Int      @default(0)
  status          String   @default("active") // active, returned, overdue, lost
  fineAmount      Float    @default(0)
  finePaid        Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

