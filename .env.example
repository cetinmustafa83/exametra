# SchoolOS environment configuration
# Copy this file to .env. Do not commit a populated .env file.

# SQLite database. Docker Compose overrides this with /data/db/schulos.db.
DATABASE_URL=file:./db/schulos.db

# Public application URL. Use the externally reachable HTTPS URL in production.
# Multiple comma-separated trusted origins are allowed for approved deployment URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session and deployment configuration
NODE_ENV=production
SESSION_MAX_AGE_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600
# Self-hosted default: new accounts are verified immediately. Set true only when
# an external email verification delivery flow is configured.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Development-only: return reset tokens in API responses instead of email.
AUTH_SHOW_RESET_TOKEN=false
SCHULOS_PORT=3000

# Local filesystem storage. Docker Compose maps these paths to a persistent volume.
STORAGE_PATH=./data/uploads
EXPORT_PATH=./data/exports
BACKUP_PATH=./data/backups

# Optional mail delivery for password reset and notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional AI provider configuration. Leave disabled unless the school enables AI.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
